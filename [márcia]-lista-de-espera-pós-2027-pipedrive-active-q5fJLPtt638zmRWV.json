    {
      "parameters": {
        "jsCode": "// ================================\n// 1. Captura do payload\n// ================================\nconst payload = $input.first().json;\n\n// ================================\n// 2. Detecta tipo da entrada\n// ================================\nconst pessoa =\n  payload.data?.[0] ||     // retorno de person\n  payload.data ||          // webhook de deal\n  {};\n\n// ================================\n// 3. Captura telefone\n// ================================\nconst telefoneOriginal =\n  pessoa.phone?.[0]?.value ||\n  '';\n\n// ================================\n// 4. Remove tudo que não for número\n// ================================\nlet telefone = telefoneOriginal.replace(/\\D/g, '');\n\n// ================================\n// 5. Remove código do país (55)\n// ================================\nif (telefone.startsWith('55')) {\n  telefone = telefone.substring(2);\n}\n\n// ================================\n// 6. Extrai DDD e número\n// ================================\nconst ddd = telefone.substring(0, 2);\nlet numero = telefone.substring(2);\n\n// ================================\n// 7. Garante o 9º dígito\n// ================================\nif (numero.length === 8) {\n  numero = '9' + numero;\n}\n\n// ================================\n// 8. Monta telefone padronizado\n// ================================\nconst telefonePadronizado =\n  telefone\n    ? `55${ddd}${numero}`\n    : '';\n\n// ================================\n// 9. Captura código da UF\n// ================================\nconst codigoUF =\n  pessoa['f77f5009ce48d7b62427c2d0961522f1830eb66e'];\n\n// ================================\n// 10. Mapa código → UF\n// ================================\nconst mapaUF = {\n  6050: \"AC\",\n  6051: \"AL\",\n  6052: \"AP\",\n  6053: \"AM\",\n  6054: \"BA\",\n  6055: \"CE\",\n  6056: \"DF\",\n  6057: \"ES\",\n  6058: \"GO\",\n  6059: \"MA\",\n  6060: \"MT\",\n  6061: \"MS\",\n  6062: \"MG\",\n  6063: \"PA\",\n  6064: \"PB\",\n  6065: \"PR\",\n  6066: \"PE\",\n  6067: \"PI\",\n  6068: \"RJ\",\n  6069: \"RN\",\n  6070: \"RS\",\n  6071: \"RO\",\n  6072: \"RR\",\n  6073: \"SC\",\n  6074: \"SP\",\n  6075: \"SE\",\n  6076: \"TO\"\n};\n\n// ================================\n// 11. Resolve UF\n// ================================\nconst uf = mapaUF[codigoUF] || \"\";\n\n// ================================\n// 12. Dados extras do deal\n// ================================\nconst dealId = pessoa.id || null;\nconst personId = pessoa.person_id || null;\nconst titulo = pessoa.title || \"\";\n\n// ================================\n// 13. Retorno\n// ================================\nreturn {\n  ddd,\n  telefonePadronizado,\n  uf,\n  dealId,\n  personId,\n  titulo\n};"
      },
